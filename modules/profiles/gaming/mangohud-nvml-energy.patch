diff --git a/src/nvidia.cpp b/src/nvidia.cpp
index 1c472dd..2739a35 100644
--- a/src/nvidia.cpp
+++ b/src/nvidia.cpp
@@ -121,11 +121,33 @@ void NVIDIA::get_instant_metrics_nvml(struct gpu_metrics *metrics, struct overla
         }
 
         if (params->enabled[OVERLAY_PARAM_ENABLED_gpu_power] || (logger && logger->is_active())) {
-            unsigned int power, limit;
-            nvml->nvmlDeviceGetPowerUsage(device, &power);
-            nvml->nvmlDeviceGetPowerManagementLimit(device, &limit);
-            metrics->powerUsage = power / 1000;
-            metrics->powerLimit = limit / 1000;
+            // Prefer the energy counter (Volta and newer). The 32-bit NVML
+            // returns NVML_SUCCESS with garbage from nvmlDeviceGetPowerUsage,
+            // and leaves the limit unwritten, but its energy counter is right.
+            // The counter ticks about every 100 ms, so single samples read 0
+            // or a spike; the average over METRICS_SAMPLE_COUNT is correct.
+            unsigned long long energy = 0;
+            if (nvml->nvmlDeviceGetTotalEnergyConsumption &&
+                nvml->nvmlDeviceGetTotalEnergyConsumption(device, &energy) == NVML_SUCCESS) {
+                auto now = std::chrono::steady_clock::now();
+                float power = 0.f;
+                if (last_energy && energy >= last_energy) {
+                    std::chrono::duration<float> elapsed = now - last_energy_time;
+                    if (elapsed.count() > 0.f)
+                        power = (energy - last_energy) / 1000.f / elapsed.count();
+                }
+                last_energy = energy;
+                last_energy_time = now;
+                metrics->powerUsage = power;
+            } else {
+                unsigned int power = 0;
+                if (nvml->nvmlDeviceGetPowerUsage(device, &power) == NVML_SUCCESS)
+                    metrics->powerUsage = power / 1000;
+            }
+
+            unsigned int limit = 0;
+            if (nvml->nvmlDeviceGetPowerManagementLimit(device, &limit) == NVML_SUCCESS)
+                metrics->powerLimit = limit / 1000;
         }
 
         if (params->enabled[OVERLAY_PARAM_ENABLED_throttling_status]) {
