# Template for ~/.config/zsh/local.zsh, which modules/home/shell/env.nix
# sources at shell start on the Macs. That file lives outside this public
# repo: copy this there and fill in real values.
#
#   cp modules/home/shell/local.zsh.example ~/.config/zsh/local.zsh
#   chmod 600 ~/.config/zsh/local.zsh
#
# Keep sensitive or machine-specific values (internal hostnames, secret
# lookup IDs, work tokens, account-specific resource IDs) here, never in the
# tracked Nix files. Blocks marked [mac mini] / [macbook] belong on that host
# only; unmarked blocks go everywhere.

# ─── Work secrets (Bitwarden Secrets Manager, lazily fetched) ───────────
# Nothing here touches the network at shell start. Each `bws` fetch is a
# ~0.16s round trip, so instead of fetching everything up front, a `preexec`
# hook loads a group of secrets the first time a command needs it. Fetches
# stay live: rotate a key in Bitwarden and the next shell picks it up.
# `load-secrets -f` re-fetches in a shell that has already loaded a group.
#
# BWS_ACCESS_TOKEN must already be set when this file is sourced (it comes
# from ~/.env_vars via .zshenv; see env.nix), or the hook is never installed.
if command -v bws >/dev/null 2>&1 && [ -n "${BWS_ACCESS_TOKEN:-}" ]; then
  _bws() {
    bws secret get "$1" --access-token "$BWS_ACCESS_TOKEN" 2>/dev/null \
      | jq -r '.value' 2>/dev/null
  }

  # Not a secret, so set eagerly: the Nomad CLI needs NOMAD_ADDR even for
  # commands that present no token.
  export NOMAD_ADDR="http://<nomad-host>:4646"

  # ─── Group loaders ───────────────────────────────────────────────────
  # One function per group. Keep groups small: a command that needs one value
  # fetches its whole group. Values derived from a secret go in its loader.
  _secrets_load_nomad() {
    export NOMAD_OPERATOR_TOKEN="$(_bws "<nomad-token-secret-id>")"
    export NOMAD_TOKEN="$NOMAD_OPERATOR_TOKEN"
  }

  _secrets_load_sentry() {
    export SENTRY_ACCESS_TOKEN_CLAUDE="$(_bws "<sentry-access-token-secret-id>")"
    export SENTRY_ACCESS_TOKEN_MCP="$SENTRY_ACCESS_TOKEN_CLAUDE"
    export SENTRY_AUTH_TOKEN="$(_bws "<sentry-auth-token-secret-id>")"
  }

  _secrets_load_grafana() {
    export GRAFANA_TOKEN_TYTO_CLAUDE_MCP="$(_bws "<grafana-token-secret-id>")"
    export GRAFANA_SERVICE_ACCOUNT_TOKEN_MCP="$GRAFANA_TOKEN_TYTO_CLAUDE_MCP"
  }

  _secrets_load_cloudflare() {
    export CLOUDFLARE_BIRDIE_API_TOKEN="$(_bws "<cloudflare-token-secret-id>")"
  }

  # ─── Machinery ───────────────────────────────────────────────────────
  # Which groups have been loaded in THIS shell.
  typeset -gA _secrets_loaded=()

  _secrets_need() {
    local g
    for g in "$@"; do
      [[ -n ${_secrets_loaded[$g]-} ]] && continue
      _secrets_loaded[$g]=1
      _secrets_load_$g
    done
  }

  # Load every group into the current shell, for anything the preexec
  # patterns can't see (a GUI app, an MCP server started by something other
  # than `claude`). `-f` re-fetches loaded groups, e.g. after a rotation.
  load-secrets() {
    [[ $1 == -f ]] && _secrets_loaded=()
    _secrets_need nomad sentry grafana cloudflare
  }

  # Load only the groups the command line needs. `;|` keeps testing later
  # patterns, so a line naming two tools loads both.
  #
  # Patterns see only the typed text, so match the command, not the secret's
  # name: the Cloudflare token is used by a terraform wrapper, `./tf`. Keep
  # them narrow: a bare *tf* would fire on every .tf file you edit. A false
  # positive costs one round trip; a miss leaves the variable silently empty.
  _secrets_preexec() {
    case $1 in
      *nomad*)                        _secrets_need nomad ;|
      *sentry*)                       _secrets_need sentry ;|
      *grafana*)                      _secrets_need grafana ;|
      ./tf|./tf\ *|*terraform*|*tofu*) _secrets_need cloudflare ;|
      # Claude Code's MCP servers read SENTRY_* and GRAFANA_* from the
      # environment it inherits, so load them before it launches.
      claude|claude\ *)               _secrets_need sentry grafana ;|
    esac
  }

  autoload -Uz add-zsh-hook
  add-zsh-hook preexec _secrets_preexec

  # A secret with no known consumer gets no pattern; `load-secrets` still
  # exports it.
fi

# preexec only fires in interactive shells: scripts, cron jobs and GUI apps
# must call `load-secrets` first (or read the value from `bws` directly).

# ─── AWS-managed EC2 instance shortcuts (account-specific resource IDs) ──
alias vpn-start='aws ec2 start-instances --profile <profile> --region <region> --instance-ids <instance-id>'
alias vpn-stop='aws ec2 stop-instances --profile <profile> --region <region> --instance-ids <instance-id>'
alias vpn-status="aws ec2 describe-instances --profile <profile> --region <region> | jq '.Reservations[0].Instances[0].State'"

# [macbook] Factorio server, a different AWS profile and region to the VPN box.
alias factorio-start='aws ec2 start-instances --profile <profile> --region <region> --instance-ids <instance-id>'
alias factorio-stop='aws ec2 stop-instances --profile <profile> --region <region> --instance-ids <instance-id>'
alias factorio-status="aws ec2 describe-instances --profile <profile> --region <region> | jq '.Reservations[0].Instances[0].State'"

# ─── Misc machine-local aliases ─────────────────────────────────────────
# `factorio` launches the game; the factorio-* aliases above drive the
# server's EC2 box. Similar names, unrelated jobs.
alias factorio='<launch-command>'
