# AeroSpace config template. aerospace.nix renders it into
# ~/.config/aerospace/aerospace.toml, substituting the gaps from
# bar-geometry.nix and the per-host window rules. Edits need
# `darwin-rebuild switch`, which also reloads AeroSpace.
#
# Workspaces are virtual: AeroSpace cycles them inside one native macOS Space,
# so Mission Control swipes don't show them.

# Omitting config-version means v1, which warns on every reload. v2 also stops
# inferring persistent-workspaces from the keybindings; it's unset here, so
# empty workspaces don't persist. AeroSpace has no config-path flag and reports
# an error if it finds two configs, so a change can only be checked once a
# rebuild has made it live:
#
#   aerospace reload-config --dry-run --warnings-as-errors
config-version = 2

start-at-login = false # nix-darwin launchd agent handles startup instead.

after-startup-command = ["layout tiles horizontal vertical"]

enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

# No accordion peek padding: stacked windows fully overlap.
accordion-padding = 0

default-root-container-layout = "tiles"
default-root-container-orientation = "auto"

# Don't move the mouse when focus changes.
on-focus-changed = []
on-focused-monitor-changed = []

# Ping edgebar's socket so the bar re-queries workspaces only on a change.
# Backgrounded so AeroSpace never waits; a no-op if edgebar isn't running.
exec-on-workspace-change = ['/bin/bash', '-c', 'nc -U "$HOME/.cache/edgebar/ws.sock" </dev/null >/dev/null 2>&1 &']

# ─── Gaps ──────────────────────────────────────────────────────────────────
# Substituted from flake.lib.barGeometry; set them in bar-geometry.nix, not
# here. outer.top clears the edgebar band (an overlay with no padding of its
# own) plus one outer gap.
[gaps]
inner.horizontal = @innerGap@
inner.vertical = @innerGap@
outer.left = @outerGap@
outer.right = @outerGap@
outer.top = @outerTop@
outer.bottom = @outerGap@

# ─── Workspace → monitor pinning ───────────────────────────────────────────
# 1–5 on the main display, 6–0 on the other. `secondary` only resolves with
# exactly two monitors, and a pattern that resolves to nothing leaves the
# workspace on the main monitor, so with 1 or 3+ monitors 6–0 just join 1–5.
# On the MBP an open lid counts as a monitor: clamshell + 2 externals splits,
# lid open + 2 externals doesn't. Patterns resolve per lookup, so unplugging a
# display strands nothing.
#
# `main` is System Settings → Displays → Use as, not a physical position.
# Sequence numbers (1, 2, left to right) follow position instead, but
# reshuffle when a display is added on the left.
#
# Side effects: alt-6..0 focus the other display rather than switching this
# one (`summon-workspace N` pulls a workspace here instead), and
# `move-workspace-to-monitor` has no effect on these workspaces.
[workspace-to-monitor-force-assignment]
1 = 'main'
2 = 'main'
3 = 'main'
4 = 'main'
5 = 'main'
6 = 'secondary'
7 = 'secondary'
8 = 'secondary'
9 = 'secondary'
0 = 'secondary'

# ─── Workspace assignment (per machine) ────────────────────────────────────
# AeroSpace doesn't remember window placement across restarts; these rules
# are the only memory. Generated from `local.aerospace.windowAssignments`,
# set per host in modules/hosts/. They sit above the float rules because only
# the first matching rule runs (check-further-callbacks defaults to false).
@windowRules@
# ─── Float rules ───────────────────────────────────────────────────────────
# Matched on app name (anchored regex), so no bundle IDs are needed.
#
# DBeaver needs no rule: AeroSpace floats dialogs itself, before any rule
# runs, and counts a window whose subrole isn't AXStandardWindow, or that has
# no enabled fullscreen button, as a dialog. That covers DBeaver's Eclipse
# dialogs while its main window tiles. If a dialog still gets tiled, float it
# by title in a rule above this one rather than floating all of DBeaver.

[[on-window-detected]]
if.app-name-regex-substring = '^(System Settings|Calculator|Hammerspoon|Notes|Activity Monitor|App Store|Software Update|Raycast|Photo Booth|Jitsi Meet|Shortcat|Screen Sharing|Godot|Finder)$'
run = "layout floating"

# ─── Keybindings ───────────────────────────────────────────────────────────
# Two paths into commands:
#   1. Hyper mode: press F18, then a single letter; esc returns to main.
#   2. Direct combo: cmd+alt+ctrl+shift+<letter> from anywhere. AeroSpace has
#      no `hyper` modifier, so it's spelt out.
# Nothing in this repo emits F18 (karabiner.json has no mapping for it), and
# Hammerspoon's hyper.lua binds it too.

[mode.main.binding]
f18 = "mode hyper"

# AeroSpace's default workspace bindings, restated: a [mode.main.binding]
# table replaces the defaults rather than merging, so without these alt-1..0
# would do nothing.
alt-1 = "workspace 1"
alt-2 = "workspace 2"
alt-3 = "workspace 3"
alt-4 = "workspace 4"
alt-5 = "workspace 5"
alt-6 = "workspace 6"
alt-7 = "workspace 7"
alt-8 = "workspace 8"
alt-9 = "workspace 9"
alt-0 = "workspace 0"

alt-shift-1 = "move-node-to-workspace 1"
alt-shift-2 = "move-node-to-workspace 2"
alt-shift-3 = "move-node-to-workspace 3"
alt-shift-4 = "move-node-to-workspace 4"
alt-shift-5 = "move-node-to-workspace 5"
alt-shift-6 = "move-node-to-workspace 6"
alt-shift-7 = "move-node-to-workspace 7"
alt-shift-8 = "move-node-to-workspace 8"
alt-shift-9 = "move-node-to-workspace 9"
alt-shift-0 = "move-node-to-workspace 0"

# Layout switches (direct combo)
cmd-alt-ctrl-shift-n = "layout accordion horizontal vertical"
cmd-alt-ctrl-shift-m = "layout tiles horizontal vertical"

# Toggle floating. AeroSpace has no centred-grid sizing, so a floated window
# keeps its prior size.
cmd-alt-ctrl-shift-t = "layout floating tiling"

# Fills the monitor without entering native macOS fullscreen.
cmd-alt-ctrl-shift-f = "fullscreen"

cmd-alt-ctrl-shift-e = "balance-sizes"

cmd-alt-ctrl-shift-r = "reload-config"

[mode.hyper.binding]
esc = "mode main"

# The direct combos above as single keys. Each ends with `mode main`, so hyper
# mode exits after one action.
n = ["layout accordion horizontal vertical", "mode main"]
m = ["layout tiles horizontal vertical", "mode main"]
t = ["layout floating tiling", "mode main"]
f = ["fullscreen", "mode main"]
e = ["balance-sizes", "mode main"]
r = ["reload-config", "mode main"]

# cmd+alt aliases inside hyper mode, carried over from the old skhd config.
cmd-alt-b = ["layout tiles horizontal vertical", "mode main"]
cmd-alt-t = ["layout floating tiling", "mode main"]
